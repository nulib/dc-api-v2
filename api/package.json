{
  "name": "dc-api",
  "version": "2.11.3",
  "description": "NUL Digital Collections API",
  "repository": "https://github.com/nulib/dc-api-v2",
  "author": "nulib",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "tsc --noEmit",
    "lint": "eslint src test",
    "prettier": "prettier -c src test",
    "prettier:fix": "prettier -cw src test",
    "validate-spec": "bunx @openapitools/openapi-generator-cli validate -i ../docs/docs/spec/openapi.yaml"
  },
  "dependencies": {
    "@aws-crypto/sha256-browser": "^2.0.1",
    "@aws-sdk/client-s3": "^3.563.0",
    "@aws-sdk/client-secrets-manager": "^3.563.0",
    "@aws-sdk/client-ses": "^3.563.0",
    "@aws-sdk/client-sfn": "^3.563.0",
    "@aws-sdk/client-sns": "^3.563.0",
    "@aws-sdk/credential-provider-node": "^3.563.0",
    "@aws-sdk/s3-request-presigner": "^3.563.0",
    "@honeybadger-io/js": "^4.9.3",
    "@hono/mcp": "^0.3.0",
    "@smithy/protocol-http": "^3.3.0",
    "@smithy/signature-v4": "^2.3.0",
    "cookie": "^0.5.0",
    "hono": "^4.12.18",
    "http-status-codes": "^2.2.0",
    "iiif-builder": "^1.0.7",
    "jose": "^5.0.0",
    "jsonschema": "^1.4.1",
    "lz-string": "^1.4.4",
    "md5": "^2.3.0",
    "mime-types": "^2.1.35",
    "parse-http-header": "^1.0.1",
    "sort-json": "^2.0.1",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@smithy/types": "^4.14.1",
    "@types/cookie": "^0.5",
    "@types/md5": "^2",
    "@types/mime-types": "^2",
    "aws-sdk-client-mock": "^4.0.0",
    "bun-types": "latest",
    "eslint": "^9",
    "msw": "^2.0.0",
    "prettier": "^3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.3"
  }
}
